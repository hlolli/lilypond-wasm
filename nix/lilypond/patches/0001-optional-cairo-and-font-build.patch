-STEPMAKE_FONTFORGE(REQUIRED)
-
-AC_PATH_PROG([T1ASM],[t1asm])
-AS_VAR_IF([T1ASM],[],[AC_MSG_ERROR([cannot find t1asm])])
+if test "$FONTS" = "yes"; then
+    STEPMAKE_FONTFORGE(REQUIRED)

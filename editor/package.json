{
  "name": "@hlolli/lilypond-wasm-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Browser editor and player for the LilyPond WASM runtime",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bun run typecheck && bun scripts/build.ts",
    "dev": "bun run build && bun scripts/serve.ts",
    "preview": "bun scripts/serve.ts",
    "test": "bun test --path-ignore-patterns='dist/**'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@csound/browser": "7.0.0-beta31",
    "@hlolli/lilypond-wasm": "0.1.0-alpha.3",
    "@lezer/highlight": "1.2.3",
    "@napi-rs/wasm-runtime": "1.1.6",
    "@tybys/wasm-util": "0.10.3",
    "codemirror": "6.0.2",
    "codemirror-lang-lilypond": "0.0.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
